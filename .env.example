GITHUB_USERNAME=alishaaverma
# Fine-grained or classic token with no scopes (public data only). Strongly recommended:
# raises the rate limit from 60 to 5000 req/hour and enables GraphQL stats.
GITHUB_TOKEN=
# Seconds GitHub's image proxy may cache each card (default 1800 = 30 min)
CACHE_SECONDS=1800
# Optional: override the display name (defaults to your GitHub name)
PROFILE_NAME=
